    "vue": "^3.5.13",
    "vue-meta": "^3.0.0-alpha.10",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/test-utils": "^2.4.4",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-vue": "^9.23.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.17",
    "vite": "^6.2.4",
    "vitest": "^3.1.3"
  }
