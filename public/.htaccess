# Sécurité et performances pour le portfolio Valentin Fiess
# https://valentin-fiess.fr

# Encodage explicite pour les pages et ressources texte destinées aux crawlers.
AddDefaultCharset UTF-8

# 1. Activer la réécriture d'URL
RewriteEngine On

# 1.5. Négociation Markdown pour les agents, puis routing SPA.
# Une requête explicite Accept: text/markdown sur l'accueil reçoit llms.txt.
RewriteCond %{HTTP_ACCEPT} (^|,)[[:space:]]*text/markdown([;,]|$) [NC]
RewriteRule ^$ llms.txt [END]

# Redirige tout vers index.html sauf si le fichier existe.
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html\ HTTP/
RewriteRule ^index\.html$ https://valentin-fiess.fr/ [R=301,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [QSA,L]

# llms.txt est aussi la représentation Markdown négociée de l'accueil.
<Files "llms.txt">
    ForceType text/markdown
</Files>

# 2. Protection contre les attaques XSS et Headers de sécurité
<IfModule mod_headers.c>
    # --- Exclure Matomo des headers de sécurité restrictifs ---
    # Matomo a besoin de ses propres règles CSP/frame pour fonctionner correctement.
    <If "%{REQUEST_URI} =~ m#^/matomo/#">
        Header unset Content-Security-Policy
        Header unset X-Frame-Options
    </If>

    # --- CSP AJUSTÉE (appliquée uniquement hors /matomo/) ---
    # Réintégration de 'unsafe-inline' pour supporter la protection anti-bot dynamique de Cloudflare.
    # Suppression du hash statique qui ne fonctionnait pas.
    <If "%{REQUEST_URI} !~ m#^/matomo/#">
        Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' 'unsafe-inline' https://www.google-analytics.com https://www.googletagmanager.com https://gradio.s3-us-west-2.amazonaws.com https://static.cloudflareinsights.com https://valmtp3-chatbot-ia-cv.hf.space https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://gradio.s3-us-west-2.amazonaws.com https://valmtp3-chatbot-ia-cv.hf.space; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com https://valmtp3-chatbot-ia-cv.hf.space wss://valmtp3-chatbot-ia-cv.hf.space https://gradio.s3-us-west-2.amazonaws.com https://huggingface.co https://api.emailjs.com https://challenges.cloudflare.com; frame-src 'self' https://valmtp3-chatbot-ia-cv.hf.space https://challenges.cloudflare.com; frame-ancestors 'none';"
        Header always set X-Frame-Options "SAMEORIGIN"
    </If>

    # Protection XSS
    Header always set X-XSS-Protection "1; mode=block"
    # Prévention du MIME sniffing
    Header always set X-Content-Type-Options "nosniff"
    # Referrer Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # Permissions Policy
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

    # Découverte de ressources par les agents après la réécriture SPA (RFC 8288).
    <Files "index.html">
        Header always set Link "</llms.txt>; rel=\"describedby\"; type=\"text/markdown\""
        Header always merge Vary "Accept"
    </Files>

    # Le type doit rester explicite après la réécriture interne de l'accueil.
    <Files "llms.txt">
        Header always set Content-Type "text/markdown; charset=UTF-8"
    </Files>

    # Les manifestes de découverte doivent être rafraîchis rapidement par les CDN.
    <FilesMatch "^(robots\.txt|llms\.txt|sitemap\.xml)$">
        Header always set Cache-Control "public, max-age=300, must-revalidate"
    </FilesMatch>

    # Les noms générés par Vite contiennent un hash : ils peuvent être mis en cache durablement.
    <FilesMatch "-[A-Za-z0-9_-]{8,}\.(css|js|woff2?)$">
        Header always set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# 3. Compression GZIP/Brotli
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css
    AddOutputFilterByType DEFLATE application/xml application/xhtml+xml application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json application/ld+json
    AddOutputFilterByType DEFLATE font/woff font/woff2 application/font-woff application/font-woff2
</IfModule>

# 4. Cache des ressources statiques (Browser Caching)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
    ExpiresByType font/woff "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 month"
    ExpiresByType application/font-woff "access plus 1 month"
    ExpiresByType application/font-woff2 "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType application/x-javascript "access plus 1 week"
    ExpiresByType text/html "access plus 1 hour"
    ExpiresByType application/json "access plus 0 seconds"
</IfModule>

# 5. Protection des fichiers sensibles
<FilesMatch "\.(htaccess|htpasswd|ini|log|sh|inc|bak|sql|conf|git)$">
    Require all denied
</FilesMatch>

# Protection spécifique du dossier .git
RewriteRule ^\.git - [F,L]

# 6. Limitation des méthodes HTTP
<LimitExcept GET POST HEAD OPTIONS>
    Require all denied
</LimitExcept>

# 7. Protection contre le hotlinking (Vol de bande passante images)
RewriteCond %{HTTP_REFERER} !^$
RewriteCond %{HTTP_REFERER} !^https?://(www\.)?valentin-fiess\.fr [NC]
RewriteCond %{REQUEST_FILENAME} \.(gif|jpe?g|png|webp|svg)$ [NC]
RewriteRule . - [F,L]

# 8. Gestion des erreurs
ErrorDocument 404 /index.html
ErrorDocument 500 /index.html
