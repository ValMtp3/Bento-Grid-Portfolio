# Sécurité et performances pour le portfolio Valentin Fiess
# https://valentin-fiess.fr

# Encodage explicite pour les pages et ressources texte destinées aux crawlers.
AddDefaultCharset UTF-8

# 1. Activer la réécriture d'URL
RewriteEngine On

# mod_dir redirige par défaut /about vers /about/ dès qu'un dossier du même nom
# existe dans dist/ -- et il agit avant les règles ci-dessous. Conséquences :
# chaque page interne coûtait une redirection 301 supplémentaire, l'URL servie
# ne correspondait plus à la balise canonical (déclarée sans barre finale), et
# la négociation Markdown ne s'appliquait jamais aux sous-pages.
# Options -Indexes accompagne obligatoirement DirectorySlash Off : sans lui, un
# dossier sans index pourrait exposer la liste de ses fichiers.
DirectorySlash Off
Options -Indexes

# 1.5. Négociation Markdown pour les agents, puis routing SPA.
#
# Trois portes d'entrée mènent au même document Markdown, parce que les agents
# n'utilisent pas tous la même convention :
#   - l'en-tête Accept: text/markdown sur l'URL HTML ;
#   - le suffixe .md ajouté à l'URL (servi directement, ce sont de vrais
#     fichiers produits par scripts/generate-agent-manifests.mjs) ;
#   - le paramètre ?mode=agent.
#
# La condition -f est indispensable : sans elle, une page sans jumeau Markdown
# renverrait un 404 au lieu de sa version HTML.

# Accueil, par négociation de contenu.
RewriteCond %{HTTP_ACCEPT} (^|,)[[:space:]]*text/markdown([;,]|$) [NC]
RewriteCond %{DOCUMENT_ROOT}/index.md -f
RewriteRule ^$ /index.md [END]

# Pages internes, par négociation de contenu.
RewriteCond %{HTTP_ACCEPT} (^|,)[[:space:]]*text/markdown([;,]|$) [NC]
RewriteCond %{DOCUMENT_ROOT}/$1.md -f
RewriteRule ^([a-z0-9-]+(?:/[a-z0-9-]+)*)/?$ /$1.md [END]

# Vue agent explicite : ?mode=agent renvoie la représentation structurée.
RewriteCond %{QUERY_STRING} (^|&)mode=agent(&|$) [NC]
RewriteCond %{DOCUMENT_ROOT}/index.md -f
RewriteRule ^$ /index.md [END]

RewriteCond %{QUERY_STRING} (^|&)mode=agent(&|$) [NC]
RewriteCond %{DOCUMENT_ROOT}/$1.md -f
RewriteRule ^([a-z0-9-]+(?:/[a-z0-9-]+)*)/?$ /$1.md [END]

# Redirige tout vers index.html sauf si le fichier existe.
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html\ HTTP/
RewriteRule ^index\.html$ https://valentin-fiess.fr/ [R=301,L]

# 1.6. Coquilles prerendues : /projets sert dist/projets/index.html, qui porte
# ses propres meta et son image OG. Servi avant le fallback SPA et sans
# redirection, pour que l'URL reste sans slash final.
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^([a-z0-9-]+(?:/[a-z0-9-]+)*)/?$ /$1/index.html [L]

# Un fichier absent sous /.well-known/, /feeds/ ou /api/ doit répondre 404,
# pas la coquille HTML de la SPA. Sans cette règle, un scanner qui demande un
# manifeste inexistant reçoit du HTML et conclut « le fichier existe mais son
# JSON est invalide » — c'est le diagnostic qu'a produit l'audit orank.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(\.well-known|feeds|api)/ - [R=404,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [QSA,L]

# Types explicites des documents destinés aux machines. Sans eux, Apache sert
# les .md en application/octet-stream et le manifeste api-catalog, qui n'a pas
# d'extension, en text/plain.
AddType text/markdown .md
AddType application/jsonl .jsonl

<Files "llms.txt">
    ForceType text/markdown
</Files>

<Files "api-catalog">
    ForceType application/linkset+json
</Files>

# 2. Protection contre les attaques XSS et Headers de sécurité
<IfModule mod_headers.c>
    # --- Exclure Matomo des headers de sécurité restrictifs ---
    # Matomo a besoin de ses propres règles CSP/frame pour fonctionner correctement.
    <If "%{REQUEST_URI} =~ m#^/matomo/#">
        Header unset Content-Security-Policy
        Header unset X-Frame-Options
    </If>

    # --- CSP AJUSTÉE (appliquée uniquement hors /matomo/) ---
    # Réintégration de 'unsafe-inline' pour supporter la protection anti-bot dynamique de Cloudflare.
    # Suppression du hash statique qui ne fonctionnait pas.
    <If "%{REQUEST_URI} !~ m#^/matomo/#">
        Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' 'unsafe-inline' https://www.google-analytics.com https://www.googletagmanager.com https://gradio.s3-us-west-2.amazonaws.com https://static.cloudflareinsights.com https://valmtp3-chatbot-ia-cv.hf.space https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://gradio.s3-us-west-2.amazonaws.com https://valmtp3-chatbot-ia-cv.hf.space; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com https://valmtp3-chatbot-ia-cv.hf.space wss://valmtp3-chatbot-ia-cv.hf.space https://gradio.s3-us-west-2.amazonaws.com https://huggingface.co https://api.emailjs.com https://challenges.cloudflare.com; frame-src 'self' https://valmtp3-chatbot-ia-cv.hf.space https://challenges.cloudflare.com; frame-ancestors 'none';"
        Header always set X-Frame-Options "SAMEORIGIN"
    </If>

    # Protection XSS
    Header always set X-XSS-Protection "1; mode=block"
    # Prévention du MIME sniffing
    Header always set X-Content-Type-Options "nosniff"
    # Referrer Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # Permissions Policy
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

    # Découverte de ressources par les agents après la réécriture SPA (RFC 8288).
    # Ces liens valent pour toute page HTML : ils ne désignent que des documents
    # à l'échelle du site.
    <Files "index.html">
        Header always set Link "</llms.txt>; rel=\"describedby\"; type=\"text/markdown\", </sitemap.xml>; rel=\"sitemap\"; type=\"application/xml\", </.well-known/api-catalog>; rel=\"api-catalog\", </.well-known/agent-card.json>; rel=\"service-desc\"; type=\"application/json\", </.well-known/agent-skills/index.json>; rel=\"service-meta\"; type=\"application/json\", </schemamap.xml>; rel=\"describedby\"; type=\"application/xml\""

        # Vary: Accept est obligatoire dès qu'une URL a deux représentations.
        # Sans lui, un CDN peut resservir la variante HTML mise en cache à un
        # agent qui demande du Markdown, ou l'inverse (acceptmarkdown.com).
        Header always merge Vary "Accept"
    </Files>

    # Le jumeau Markdown est propre à chaque page : le déclarer globalement
    # ferait pointer toutes les pages vers /index.md. Seul l'accueil le porte en
    # en-tête ; les autres pages le déclarent dans leur <head>, via la balise
    # <link rel="alternate" type="text/markdown"> posée par prerender.mjs.
    <If "%{REQUEST_URI} == '/' || %{REQUEST_URI} == '/index.html'">
        Header always merge Link "</index.md>; rel=\"alternate\"; type=\"text/markdown\""
    </If>

    # Les documents Markdown varient eux aussi selon Accept : ils sont l'autre
    # face de la même URL.
    <FilesMatch "\.md$">
        Header always set Content-Type "text/markdown; charset=UTF-8"
        Header always merge Vary "Accept"
    </FilesMatch>

    # Le type doit rester explicite après la réécriture interne de l'accueil.
    <Files "llms.txt">
        Header always set Content-Type "text/markdown; charset=UTF-8"
        Header always merge Vary "Accept"
    </Files>

    # RFC 9727 impose ce type, avec le profil, pour le catalogue d'API.
    <Files "api-catalog">
        Header always set Content-Type "application/linkset+json;profile=\"https://www.rfc-editor.org/info/rfc9727\""
    </Files>

    # Les manifestes de découverte sont lus par des agents anonymes, souvent
    # depuis une autre origine : sans CORS, un agent navigateur ne peut pas les
    # lire. Ils sont publics, donc aucun risque à les ouvrir.
    <FilesMatch "^(ard\.json|ai-catalog\.json|agent-card\.json|api-catalog|index\.json|server-card\.json)$">
        Header always set Access-Control-Allow-Origin "*"
    </FilesMatch>

    # Les manifestes de découverte doivent être rafraîchis rapidement par les CDN.
    <FilesMatch "^(robots\.txt|llms\.txt|sitemap\.xml)$">
        Header always set Cache-Control "public, max-age=300, must-revalidate"
    </FilesMatch>

    # Les noms générés par Vite contiennent un hash : ils peuvent être mis en cache durablement.
    <FilesMatch "-[A-Za-z0-9_-]{8,}\.(css|js|woff2?)$">
        Header always set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# 3. Compression GZIP/Brotli
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css
    AddOutputFilterByType DEFLATE application/xml application/xhtml+xml application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json application/ld+json
    AddOutputFilterByType DEFLATE font/woff font/woff2 application/font-woff application/font-woff2
</IfModule>

# 4. Cache des ressources statiques (Browser Caching)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
    ExpiresByType font/woff "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 month"
    ExpiresByType application/font-woff "access plus 1 month"
    ExpiresByType application/font-woff2 "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType application/x-javascript "access plus 1 week"
    ExpiresByType text/html "access plus 1 hour"
    ExpiresByType application/json "access plus 0 seconds"
</IfModule>

# 5. Protection des fichiers sensibles
# .DS_Store est ajoute a la liste : macOS en depose dans chaque dossier, Vite
# les recopie de public/ vers dist/, et ils partent en ligne au deploiement. Le
# fichier revele les noms de tout ce que contient le dossier, y compris ce qui
# n'est reference nulle part.
<FilesMatch "\.(htaccess|htpasswd|ini|log|sh|inc|bak|sql|conf|git|DS_Store)$">
    Require all denied
</FilesMatch>

# Protection spécifique du dossier .git
RewriteRule ^\.git - [F,L]

# 6. Limitation des méthodes HTTP
<LimitExcept GET POST HEAD OPTIONS>
    Require all denied
</LimitExcept>

# 7. Protection contre le hotlinking (Vol de bande passante images)
RewriteCond %{HTTP_REFERER} !^$
RewriteCond %{HTTP_REFERER} !^https?://(www\.)?valentin-fiess\.fr [NC]
RewriteCond %{REQUEST_FILENAME} \.(gif|jpe?g|png|webp|svg)$ [NC]
RewriteRule . - [F,L]

# 8. Gestion des erreurs
#
# Les visiteurs reçoivent la SPA, qui affiche sa page 404. Les chemins destinés
# aux machines reçoivent du JSON : un agent ne sait pas lire une page d'erreur
# HTML, et l'audit orank compte explicitement ce point.
ErrorDocument 404 /index.html
ErrorDocument 500 /index.html

<If "%{REQUEST_URI} =~ m#^/(\.well-known|feeds|api)/#">
    ErrorDocument 404 /errors/404.json
    ErrorDocument 500 /errors/500.json
</If>
